# Copy to .dev.vars and replace AUTH_SECRET with a unique random value.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_BASE_URL=http://localhost:8787
OIDC_EMAIL_DOMAIN=
FINGERPRINT_MODE=disabled
FINGERPRINT_REGION=us
FINGERPRINT_SERVER_API_KEY=
FINGERPRINT_MIN_CONFIDENCE=0.7
FINGERPRINT_SUSPECT_SCORE_THRESHOLD=
FINGERPRINT_MAX_EVENT_AGE_SECONDS=120
FINGERPRINT_ALLOWED_ORIGINS=
ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_TOKEN=
ENABLE_MIGRATIONS=false
MIGRATION_TOKEN=
ENABLE_DYNAMIC_CLIENT_REGISTRATION=false
CLIENT_REGISTRATION_TOKEN=
