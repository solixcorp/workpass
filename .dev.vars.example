# Copy to .dev.vars and replace AUTH_SECRET with a unique random value.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_BASE_URL=http://localhost:8787
OIDC_EMAIL_DOMAIN=
FINGERPRINT_MODE=disabled
FINGERPRINT_REGION=us
FINGERPRINT_SERVER_API_KEY=
FINGERPRINT_MIN_CONFIDENCE=0.7
FINGERPRINT_SUSPECT_SCORE_THRESHOLD=
FINGERPRINT_MAX_EVENT_AGE_SECONDS=120
FINGERPRINT_ALLOWED_ORIGINS=
ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_TOKEN=
ENABLE_MIGRATIONS=false
MIGRATION_TOKEN=
ENABLE_DYNAMIC_CLIENT_REGISTRATION=false
CLIENT_REGISTRATION_TOKEN=
ENABLE_SCIM_PROVISIONING=false
# Dev-only: permits an http://127.0.0.1|localhost SCIM target for local transport
# verification. Never enable in production; production targets stay https-only.
# Sealed storage: sensitive material at rest (e.g. hardware OTP token
# secrets) is XChaCha20-Poly1305-sealed. The key is 32 bytes, base64; the
# cipher is xchacha20poly1305 (the configurable, only current, choice).
# Generate one with:  bun -e "console.log(btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(32)))))"
AEAD_SEALING_KEY=
SEALED_STORAGE_CIPHER=xchacha20poly1305
# Inbound SCIM (RFC 7644): workforce systems provision users INTO this
# platform over bearer-token-protected /scim/v2 endpoints. Token must be
# >= 32 bytes; provisioned users carry no credential.
ENABLE_INBOUND_SCIM=false
INBOUND_SCIM_BEARER_TOKEN=
# SCIM_DEV_LOOPBACK_TARGET=false
SCIM_TARGET_ID=
SCIM_BASE_URL=
SCIM_BEARER_TOKEN=
# SAML identity provider signing material (required only for issuing signed
# SAML responses). Generate with: bun run scripts/generate-saml-key.ts
SAML_IDP_ENTITY_ID=
SAML_IDP_SIGNING_CERTIFICATE=
SAML_IDP_SIGNING_PRIVATE_KEY=
# During a rotation overlap window, keep the previous pair published; SPs verify
# tokens signed by either key until the rollover completes.
SAML_IDP_PREVIOUS_SIGNING_CERTIFICATE=
SAML_IDP_PREVIOUS_SIGNING_PRIVATE_KEY=
# OPAQUE (RFC 9807) zero-password authentication: server master key, 32 bytes base64.
# OPAQUE_MASTER_KEY=
# RFC 8693 token exchange (opt-in): disabled unless ENABLE_TOKEN_EXCHANGE=true.
# The allowlist maps each confidential client id to the exact resource URIs it
# may receive after exchange; anything missing from the map is denied. Resource
# URIs (and their TTLs) are seeded from OAUTH_RESOURCES; a delegation target
# must have a strictly shorter accessTokenTtl than the subject's source
# resource so exchanged tokens can never outlive the subject.
ENABLE_TOKEN_EXCHANGE=false
TOKEN_EXCHANGE_ALLOWED_RESOURCES={"exchange-client":["https://api.example.com/delegated"]}
OAUTH_RESOURCES=[{"identifier":"https://api.example.com/","accessTokenTtl":600},{"identifier":"https://api.example.com/delegated","accessTokenTtl":300}]
# OAuth 1.0a server (RFC 5849, HMAC-SHA1): opt-in. OAUTH1_MANAGEMENT_TOKEN
# (>= 32 bytes) protects POST/PATCH /api/oauth1/consumers; consumers and all
# token secrets are sealed with AEAD_SEALING_KEY, which is therefore required
# when this feature is enabled.
ENABLE_OAUTH1=false
OAUTH1_MANAGEMENT_TOKEN=
# SSF (Shared Signals Framework). ENABLE_SSF_RECEIVER accepts inbound SETs for
# operator-pinned streams; ENABLE_SSF_SENDER signs outbound SETs with a
# platform RS256 key (public JWKS at /api/ssf/jwks.json) and pushes to
# operator-registered recipients. Both share SSF_MANAGEMENT_TOKEN (>= 32 bytes).
ENABLE_SSF_RECEIVER=false
ENABLE_SSF_SENDER=false
SSF_MANAGEMENT_TOKEN=
# Example inbound stream: {"id":"legacy-idp","issuer":"https://legacy-idp.example",
#   "audience":"internal-auth","jwks":{"keys":[{"kty":"RSA","kid":"k1","n":"...","e":"AQAB","alg":"RS256"}]},
#   "event_types":["https://schemas.openid.net/secevent/caep/event-type/session-revoked"],
#   "delivery_token":"shared-secret"}
SSF_STREAMS=
