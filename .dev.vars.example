# Copy to .dev.vars and replace AUTH_SECRET with a unique random value.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_BASE_URL=http://localhost:8787
OIDC_EMAIL_DOMAIN=
FINGERPRINT_MODE=disabled
FINGERPRINT_REGION=us
FINGERPRINT_SERVER_API_KEY=
FINGERPRINT_MIN_CONFIDENCE=0.7
FINGERPRINT_SUSPECT_SCORE_THRESHOLD=
FINGERPRINT_MAX_EVENT_AGE_SECONDS=120
FINGERPRINT_ALLOWED_ORIGINS=
ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_TOKEN=
ENABLE_MIGRATIONS=false
MIGRATION_TOKEN=
ENABLE_DYNAMIC_CLIENT_REGISTRATION=false
CLIENT_REGISTRATION_TOKEN=
ENABLE_SCIM_PROVISIONING=false
# Dev-only: permits an http://127.0.0.1|localhost SCIM target for local transport
# verification. Never enable in production; production targets stay https-only.
# SCIM_DEV_LOOPBACK_TARGET=false
SCIM_TARGET_ID=
SCIM_BASE_URL=
SCIM_BEARER_TOKEN=
# SAML identity provider signing material (required only for issuing signed
# SAML responses). Generate with: bun run scripts/generate-saml-key.ts
SAML_IDP_ENTITY_ID=
SAML_IDP_SIGNING_CERTIFICATE=
SAML_IDP_SIGNING_PRIVATE_KEY=
# During a rotation overlap window, keep the previous pair published; SPs verify
# tokens signed by either key until the rollover completes.
SAML_IDP_PREVIOUS_SIGNING_CERTIFICATE=
SAML_IDP_PREVIOUS_SIGNING_PRIVATE_KEY=
