{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "internal-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_als"],
  "upload_source_maps": true,
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "storage": {
        // Operational diagnostics retention (decided 2026-11-10; QST-1794159887-jwy):
        // the maximum Workers Logs retention, distinct from the one-year
        // tamper-evident security audit window in D1.
        "retention_days": 30
      }
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  // Frontend SPA (web/). Static asset requests are free and skip the Worker;
  // only the backend paths below invoke it. Keep this list in sync with
  // BACKEND_PATHS in web/vite.config.ts.
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/.well-known/*",
      "/saml/*",
      "/wsfed/*",
      "/scim/*",
      "/sign-in",
      "/auth/*",
      "/oauth2/*",
      "/enduser/*",
      "/idp/*",
      "/health",
      "/dev/*",
      "/_internal/*",
      "/application/*"
    ]
  },
  // D1 lives in Seoul (ICN). Smart Placement left the Worker in the visitor's
  // nearest edge (LAX for Korean users), so each of a request's D1 queries
  // crossed the Pacific. Pin the Worker next to the database instead.
  "placement": {
    "region": "aws:ap-northeast-2"
  },
  "vars": {
    "ENABLE_ADMIN_BOOTSTRAP": "false",
    "ENABLE_MIGRATIONS": "false",
    "ENABLE_DYNAMIC_CLIENT_REGISTRATION": "false",
    "AUTH_BASE_URL": "https://auth.solixllc.com",
    "OIDC_EMAIL_DOMAIN": "auth.solixllc.com",
    "MAIL_PROVIDER": "resend",
    "MAIL_FROM": "noreply@auth.solixllc.com",
    "SMS_PROVIDER": "solapi",
    "FINGERPRINT_ALLOWED_ORIGINS": "https://auth.solixllc.com",
    "FINGERPRINT_REGION": "us",
    "FINGERPRINT_ENDPOINT": "https://risksecurity.workpass.solixllc.com"
  },
  "routes": [
    { "pattern": "auth.solixllc.com", "custom_domain": true }
  ],
  "triggers": {
    "crons": [
      "17 4 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "internal-auth",
      "database_id": "16a9f10f-4deb-4c56-9b55-0332c0a8f75e"
    }
  ],
  // Independent audit backup (docs/security/audit-backup.md): the scheduled
  // export appends positioned audit rows to dated R2 objects; the bucket must
  // exist before the binding is deployed ("wrangler r2 bucket create
  // internal-auth-audit-backup"). All audit features fail safe when the
  // binding is absent.
  "r2_buckets": [
    {
      "binding": "AUDIT_BACKUP",
      "bucket_name": "internal-auth-audit-backup"
    },
    {
      "binding": "APPLICATION_ICONS",
      "bucket_name": "internal-auth-application-icons"
    }
  ]
}
