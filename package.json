{
  "name": "internal-auth",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --local",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "saml:keygen": "bun run scripts/generate-saml-key.ts",
    "smoke": "bun run scripts/run-all-smokes.ts",
    "verify:web": "bun run scripts/verify-web-deploy.ts",
    "provision:r2": "bun run scripts/ensure-audit-backup-bucket.ts",
    "predeploy": "bun run scripts/ensure-audit-backup-bucket.ts",
    "types:worker": "wrangler types --env-interface=WorkerBindings --strict-vars=false",
    "web:dev": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build",
    "build:check": "bun run web:build && wrangler deploy --dry-run --outdir .wrangler/deploy",
    "deploy": "bun run web:build && wrangler deploy"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.18",
    "@better-auth/passkey": "1.7.18",
    "@cloudflare/opaque-ts": "0.7.5",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "0.4.4",
    "@simplewebauthn/server": "13.3.2",
    "better-auth": "1.7.18",
    "hono": "4.11.5"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.158.0"
  }
}
